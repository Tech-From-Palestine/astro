# انسخ هذا الملف إلى .env وضع قيمك الحقيقية فيه (ملف .env لا يُرفع إلى GitHub)
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/?appName=astro
MONGODB_DB=astro
JWT_SECRET=change-this-to-a-long-random-string
PORT=5001
CLIENT_URL=http://localhost:5173
ADMIN_EMAIL=admin@astro.ps
ADMIN_PASSWORD=Admin@12345
# يضيف البيانات الأولية تلقائياً في أول تشغيل على قاعدة فارغة
AUTO_SEED=true
